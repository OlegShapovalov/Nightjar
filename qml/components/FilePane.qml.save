                    anchors.verticalCenter: parent.verticalCenter
                    anchors.right: parent.right
                    text: "Дата " + (pane.sortBy === "date" ? (pane.sortAsc ? "▲" : "▼") : "")
                    color: pane.sortBy === "date" ? "#60a5fa" : "#71717a"
